# LOONA — plantilla de variables de entorno.
#
#   cp .env.example runtime/.env
#
# Llena SOLO lo que vayas a usar. runtime/.env nunca se sube al repo (.gitignore)
# y LOONA nunca lo lee en voz alta ni lo expone por API (runtime/guardrails.py
# bloquea cualquier intento de leer .env / api keys / llavero vía /api/chat).
#
# Prioridad de cerebro (config.brain.provider, default "deepseek"): si no hay
# match explícito se prueba deepseek -> xai -> gemini -> anthropic -> ollama
# local (sin key, requiere `ollama serve` + un modelo <=7B instalado).

# DeepSeek (recomendado: barato, rápido, OpenAI-compatible) — https://platform.deepseek.com
DEEPSEEK_API_KEY=

# xAI / Grok — https://console.x.ai
XAI_API_KEY=

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Cualquier endpoint OpenAI-compatible que no sea DeepSeek (config.brain.provider = "openai-compatible")
OPENAI_API_KEY=

# Telegram — bot creado con @BotFather, para el canal opcional
TELEGRAM_BOT_TOKEN=

# Nada de esto es obligatorio: sin ninguna key, LOONA cae a Ollama local.
